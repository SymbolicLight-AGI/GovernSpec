include LICENSE
include README.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include CITATION.cff
graft packages
prune packages/governspec-ts/node_modules
prune packages/governspec-vscode/node_modules
prune packages/governspec-ts/dist
prune packages/governspec-vscode/dist
recursive-include schema *.json
recursive-include examples *.yaml *.md
recursive-include docs *.md
recursive-include benchmark *.py *.yaml *.md *.json
global-exclude __pycache__
global-exclude *.py[cod]
