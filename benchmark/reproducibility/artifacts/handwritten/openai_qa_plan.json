{
  "type": "json_schema",
  "json_schema": {
    "name": "qa_test_plan_json",
    "description": "Produce a strict QA test plan payload.",
    "strict": true,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "test_count", "cases"],
      "properties": {
        "scope": {"type": "string"},
        "test_count": {"type": "integer"},
        "cases": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}




